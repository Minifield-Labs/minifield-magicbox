# The host demo fetches paired JS/WASM assets and the model's 3 bundle files.
VITE_MAGICBOX_RUNTIME_URL=https://cdn.minifieldlabs.com/minifield-runtime/releases/VERSION/minifield_web_demo.js
VITE_MAGICBOX_MODEL_URL=https://your-cdn/magicbox/MODEL_VERSION/

# For local development, use these local URLs and serve the bundle folders.
# VITE_MAGICBOX_RUNTIME_URL=/runtime/minifield_web_demo.js
# VITE_MAGICBOX_MODEL_URL=/model/
# MAGICBOX_RUNTIME_DIR=/absolute/path/to/browser-runtime
# MAGICBOX_MODEL_DIR=/absolute/path/to/model-bundle
